data/*
# Analytics worker local artifacts/cache (explicit)
data/analytics/
# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
/server

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Frontend (React) artifacts
frontend/**/node_modules/
frontend/**/build/
frontend/**/.env
frontend/**/.env.*
frontend/**/npm-debug.log*
frontend/**/yarn-debug.log*
frontend/**/yarn-error.log*

# Local secrets
.env
.env.*

# Python analytics generated outputs and caches
**/__pycache__/
*.pyc
*.pyo
*.pyd
.~lock*
python/cluster_out/
python/derived/
python/derived_test/
python/pca_out/
python/analytics/cluster_out/
python/analytics/derived/
python/analytics/derived_test/
python/analytics/pca_out/
.ipynb_checkpoints/
