# Real-data/production instance
APP_PORT=28080
SQLITE_PATH=/opt/svwatergo/data/svwatergo-prod.db
READ_ONLY_MODE=0
INGEST_DISABLED=0

# Typical production auth/env vars (set as needed):
# GOOGLE_CLIENT_ID=...
# JWT_SECRET=...
# ADMIN_EMAILS=admin@example.com
# ALLOWED_EMAILS=admin@example.com,ops@example.com

# Optional Postgres instead of SQLITE_PATH:
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/svwatergo_prod?sslmode=disable
